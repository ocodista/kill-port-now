#!/bin/sh

bin_path=$0
while [ -h "$bin_path" ]; do
  bin_dir=$(CDPATH= cd -- "$(dirname -- "$bin_path")" && pwd)
  link_target=$(readlink "$bin_path")

  case "$link_target" in
    /*) bin_path=$link_target ;;
    *) bin_path=$bin_dir/$link_target ;;
  esac
done

script_dir=$(CDPATH= cd -- "$(dirname -- "$bin_path")" && pwd)
root_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

os=$(uname -s 2>/dev/null || echo unknown)
arch=$(uname -m 2>/dev/null || echo unknown)
platform=

case "$os:$arch" in
  Darwin:arm64|Darwin:aarch64) platform=darwin-arm64 ;;
  Darwin:x86_64) platform=darwin-x64 ;;
  Linux:x86_64|Linux:amd64) platform=linux-x64 ;;
  Linux:aarch64|Linux:arm64) platform=linux-arm64 ;;
esac

if [ -n "$platform" ]; then
  native="$root_dir/native/prebuilds/$platform/kp-rs"
  if [ -x "$native" ]; then
    exec "$native" "$@"
  fi
fi

exec node "$script_dir/kp-js" "$@"
