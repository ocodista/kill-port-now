#!/usr/bin/env node
'use strict'

const { killPorts, parsePorts } = require('../index.js')

function usage() {
  return `kill-port-now: kill the process listening on a port, fast.

Usage:
  kill-port-now <port...>
  kp <port...>
  kill-port-now --port 3000,3001

Options:
  -p, --port <ports>       Ports to kill, comma-separated or repeated
  -m, --method <protocol>  Compatibility alias for --protocol
      --protocol <value>   tcp, udp, or all (default: tcp)
  -s, --signal <signal>    Signal to send (default: SIGKILL)
      --dry-run            Print what would be killed without sending a signal
      --strict             Exit 1 when no matching process is found
  -q, --quiet              No success output
  -v, --verbose            Print matched PIDs
  -h, --help               Show help
      --version            Show version

Examples:
  kp 3000
  kill-port-now 3000 5173
  kill-port-now --port 3000,3001 --protocol all
`
}

function readVersion() {
  return require('../package.json').version
}

function takeValue(args, index, flag) {
  const nextIndex = index + 1
  const value = args[nextIndex]
  if (typeof value !== 'string' || value.startsWith('-')) {
    throw new Error(`${flag} requires a value`)
  }

  return { value, nextIndex }
}

function parseArguments(argv) {
  const ports = []
  const options = {
    protocol: 'tcp',
    signal: 'SIGKILL',
    dryRun: false,
    quiet: false,
    verbose: false,
    strict: false,
    help: false,
    version: false
  }

  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index]

    if (arg === '--') {
      ports.push(...argv.slice(index + 1))
      break
    }

    if (arg === '-h' || arg === '--help') {
      options.help = true
      continue
    }

    if (arg === '--version') {
      options.version = true
      continue
    }

    if (arg === '-q' || arg === '--quiet' || arg === '--silent') {
      options.quiet = true
      continue
    }

    if (arg === '-v' || arg === '--verbose') {
      options.verbose = true
      continue
    }

    if (arg === '--strict') {
      options.strict = true
      continue
    }

    if (arg === '--dry-run') {
      options.dryRun = true
      continue
    }

    if (arg === '-p' || arg === '--port') {
      const parsed = takeValue(argv, index, arg)
      ports.push(parsed.value)
      index = parsed.nextIndex
      continue
    }

    if (arg.startsWith('--port=')) {
      ports.push(arg.slice('--port='.length))
      continue
    }

    if (arg === '-m' || arg === '--method' || arg === '--protocol') {
      const parsed = takeValue(argv, index, arg)
      options.protocol = parsed.value
      index = parsed.nextIndex
      continue
    }

    if (arg.startsWith('--method=')) {
      options.protocol = arg.slice('--method='.length)
      continue
    }

    if (arg.startsWith('--protocol=')) {
      options.protocol = arg.slice('--protocol='.length)
      continue
    }

    if (arg === '-s' || arg === '--signal') {
      const parsed = takeValue(argv, index, arg)
      options.signal = parsed.value
      index = parsed.nextIndex
      continue
    }

    if (arg.startsWith('--signal=')) {
      options.signal = arg.slice('--signal='.length)
      continue
    }

    if (arg.startsWith('-')) {
      throw new Error(`Unknown option: ${arg}`)
    }

    ports.push(arg)
  }

  return { ports, options }
}

function formatPidList(pids) {
  return pids.length === 1 ? String(pids[0]) : pids.join(', ')
}

function printResults(results, options) {
  if (options.quiet) {
    return
  }

  for (const result of results) {
    if (result.failed.length > 0) {
      for (const failure of result.failed) {
        console.error(`failed to kill ${failure.pid} on port ${result.port}: ${failure.message}`)
      }
      continue
    }

    if (result.pids.length === 0) {
      console.log(`port ${result.port} is already free`)
      continue
    }

    const action = options.dryRun ? 'would kill' : 'killed'
    const suffix = options.verbose ? ` (${result.protocol})` : ''
    console.log(`${action} ${formatPidList(result.killed)} on port ${result.port}${suffix}`)
  }
}

async function main() {
  const parsed = parseArguments(process.argv.slice(2))

  if (parsed.options.help) {
    console.log(usage())
    return 0
  }

  if (parsed.options.version) {
    console.log(readVersion())
    return 0
  }

  const ports = parsePorts(parsed.ports)
  const results = await killPorts(ports, {
    protocol: parsed.options.protocol,
    signal: parsed.options.signal,
    dryRun: parsed.options.dryRun
  })

  printResults(results, parsed.options)

  const killedCount = results.reduce((count, result) => count + result.killed.length, 0)
  const failedCount = results.reduce((count, result) => count + result.failed.length, 0)
  if (failedCount > 0 || (parsed.options.strict && killedCount === 0)) {
    return 1
  }

  return 0
}

main()
  .then((exitCode) => {
    process.exitCode = exitCode
  })
  .catch((error) => {
    console.error(error instanceof Error ? error.message : String(error))
    process.exitCode = 1
  })
